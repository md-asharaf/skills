#!/usr/bin/env bash
set -euo pipefail
lines=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d')
count=$(printf '%s\n' "$lines" | sed '/^$/d' | wc -l)
pattern='^(feat|fix|refactor|perf|style|chore|test|docs|build|ci|revert)(\([a-z0-9-]+\))?!?: [^ ].{2,}$'
if [ "$count" -ne 1 ] || ! printf '%s' "$lines" | grep -Eq "$pattern"; then
  echo "Commit message must be one line: <type>: <description> (no body, no trailers)." >&2
  exit 1
fi
